{
  "name": "@ogm/generator",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic, server-only level generator (PRNG in CP01; topology from CP04).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:prop": "vitest run --mode prop"
  }
}
