{
  "name": "@ogm/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Pure TypeScript contracts shared by client and server: seed codec, door geometry, wire DTOs, graph searches.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:prop": "vitest run --mode prop"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
